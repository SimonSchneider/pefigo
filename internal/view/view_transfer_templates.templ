package view;

import (
	"fmt"
	"strconv"

	"github.com/SimonSchneider/pefigo/internal/model"
	"github.com/SimonSchneider/pefigo/pkg/ui"
)

// import "github.com/SimonSchneider/pefigo/pkg/uncertain"
templ PageTransferTemplates(view *model.TransferTemplatesView) {
	@Layout("/transfer-templates", TransferTemplatesContent(view))
}

templ PageEditTransferTemplate(view *model.TransferTemplateEditView) {
	@Layout("/transfer-templates", EditTransferTemplateContent(view))
}

templ EditTransferTemplateContent(view *model.TransferTemplateEditView) {
	<main class="flex-1 flex flex-col min-h-0">
		if view.IsEdit() {
			@Header("Edit Transfer Template", DeleteTransferTemplateButton(view.TransferTemplate.ID))
		} else {
			@Header("New Transfer Template", NewTransferTemplateButton())
		}
		<div class="flex-1 p-6 overflow-auto bg-base-100">
			@TransferTemplateForm(view)
		</div>
	</main>
}

templ DeleteTransferTemplateButton(id string) {
	<form method="post" action={ "/transfers/" + id + "/delete?next=" + templ.EscapeString("/transfer-templates") }>
		<button class="btn btn-error" type="submit">
			Delete
		</button>
	</form>
}

templ TransferTemplateForm(view *model.TransferTemplateEditView) {
	<form action={ "/transfers/?next=" + templ.EscapeString("/transfer-templates") } method="post">
		<input type="hidden" name="id" value={ view.TransferTemplate.ID }/>
		<div class="max-w-4xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<!-- Basic Information -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body p-5">
						<h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-3">Basic Information</h3>
						<div class="form-control">
							<label class="label"><span class="label-text font-medium">Name</span></label>
							<input type="text" class="input input-bordered w-full" placeholder="Salary Transfer" name="name" value={ view.TransferTemplate.Name }/>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text font-medium">From Account</span></label>
							<select class="select select-bordered w-full" name="from_account_id">
								<option value="">External (Income)</option>
								for _, acc := range view.Accounts {
									<option
										value={ acc.ID }
										if acc.ID == view.TransferTemplate.FromAccountID {
											selected
										}
									>{ acc.Name }</option>
								}
							</select>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text font-medium">To Account</span></label>
							<select class="select select-bordered w-full" name="to_account_id">
								<option value="">External (Expense)</option>
								for _, acc := range view.Accounts {
									<option
										value={ acc.ID }
										if acc.ID == view.TransferTemplate.ToAccountID {
											selected
										}
									>{ acc.Name }</option>
								}
							</select>
						</div>
					</div>
				</div>
				<!-- Amount Settings -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body p-5">
						<h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-3">Amount Settings</h3>
						<div class="form-control">
							<label class="label"><span class="label-text font-medium">Amount Type</span></label>
							<select class="select select-bordered w-full" name="amount_type" id="amount-type-select">
								<option
									value={ model.TransferAmountFixed }
									if view.TransferTemplate.AmountType == model.TransferAmountFixed {
										selected
									}
								>Fixed Amount</option>
								<option
									value={ model.TransferAmountPercent }
									if view.TransferTemplate.AmountType == model.TransferAmountPercent {
										selected
									}
								>Percentage</option>
							</select>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text font-medium">Fixed Amount</span></label>
							<input type="text" class="input input-bordered w-full" placeholder="1000" name="amount_fixed" value={ view.TransferTemplate.AmountFixed.SimpleEncode() }/>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text font-medium">Percentage (%)</span></label>
							<input type="number" class="input input-bordered w-full" placeholder="10" step="any" name="amount_percent" value={ ui.FormatPercent(view.TransferTemplate.AmountPercent) }/>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text font-medium">Priority</span></label>
							<input type="number" class="input input-bordered w-full" placeholder="1" name="priority" value={ view.TransferTemplate.Priority }/>
						</div>
					</div>
				</div>
				<!-- Schedule -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body p-5">
						<h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-3">Schedule</h3>
						<div class="form-control">
							<label class="label"><span class="label-text font-medium">Recurrence</span></label>
							<input type="text" class="input input-bordered w-full" placeholder="*-*-25" name="recurrence" value={ view.RecurrenceInput() }/>
							<div class="text-sm text-base-content/60 mt-1">
								Leave empty for a one-time transfer on the Start. Otherwise a date pattern, such as *-*-25 for the 25th of every month.
							</div>
						</div>
						{{ ev := view.Event() }}
						<div class="grid grid-cols-2 gap-4">
							<div class="form-control">
								<label class="label whitespace-normal">
									<span class="label-text font-medium">
										if ev != nil {
											Start, days after { ev.Name }
										} else {
											Start Date
										}
									</span>
								</label>
								<input type="text" class="input input-bordered w-full" name="start_date" value={ view.StartInput() } placeholder={ entryDatePlaceholder(ev != nil, "2027-01-01") }/>
							</div>
							<div class="form-control">
								<label class="label whitespace-normal">
									<span class="label-text font-medium">
										if ev != nil {
											End, days after { ev.Name }
										} else {
											End Date
										}
									</span>
								</label>
								<input type="text" class="input input-bordered w-full" name="end_date" value={ view.EndInput() } placeholder="Optional"/>
							</div>
						</div>
						<div class="text-sm text-base-content/60 mt-1">
							A date such as 2027-09-30, or in an Event the days after its date, such as +20. The End's first day isn't included.
						</div>
					</div>
				</div>
			<!-- Budget Category -->
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body p-5">
					<h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-3">Budget Category</h3>
					<div class="form-control">
						<label class="label"><span class="label-text font-medium">Budget Category</span></label>
						<select class="select select-bordered w-full" name="budget_category_id">
							<option value="">None (not in budget)</option>
							for _, cat := range view.Categories {
								{{ budgetSelected := false }}
								if view.TransferTemplate.BudgetCategoryID != nil && *view.TransferTemplate.BudgetCategoryID == cat.ID {
									{{ budgetSelected = true }}
								}
								<option
									value={ cat.ID }
									if budgetSelected {
										selected
									}
								>{ cat.Name }</option>
							}
						</select>
						<div class="text-sm text-base-content/60 mt-1">
							Assign a budget category to include this template in the monthly budget summary
						</div>
					</div>
				</div>
			</div>
			<!-- Event -->
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body p-5">
					<h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-3">Event</h3>
					<div class="form-control">
						<label class="label"><span class="label-text font-medium">Event</span></label>
						@EventSelect(view.Events, view.TransferTemplate.EventID, "select-bordered")
						<div class="text-sm text-base-content/60 mt-1">
							In an Event, give the Start and End as days after its date, such as +20, and they move with it. A blank Start is the Event's date.
						</div>
					</div>
				</div>
			</div>
				<!-- Advanced — full width -->
				<div class="card bg-base-100 shadow-sm border border-base-300 lg:col-span-2">
					<div class="card-body p-5">
						<h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-3">Advanced</h3>
						<div class="form-control">
							<label class="label"><span class="label-text font-medium">Enabled</span></label>
							<label class="flex items-center gap-2 cursor-pointer">
								<input
									type="checkbox"
									class="checkbox"
									name="enabled"
									if view.TransferTemplate.Enabled {
										checked
									}
								/>
								<span class="label-text">This template is active</span>
							</label>
						</div>
					</div>
				</div>
			</div>
			@SaveButton(view.IsEdit())
		</div>
	</form>
}

templ TransferTemplatesStatCardRow(view *model.TransferTemplatesView) {
	<div class="flex flex-row flex-wrap gap-4">
		@StatCard("Net Income", ui.FormatWithThousands(view.MonthlyIncome+view.MonthlyExpenses), "Net income of all accounts", IconTrendingUp("w-10 h-10 text-green-600"))
		@StatCard("Total Templates", strconv.Itoa(view.TemplateCount()), "number of templates", IconCashBanknote("w-10 h-10"))
		@StatCard("Total Income", ui.FormatWithThousands(view.MonthlyIncome), "Total income of all accounts", IconTrendingUp("w-10 h-10 text-green-600"))
		@StatCard("Total Expenses", ui.FormatWithThousands(view.MonthlyExpenses), "Total expenses of all accounts", IconTrendingDown("w-10 h-10 text-red-600"))
	</div>
}

templ TransferTemplateTableRow(view *model.TransferTemplatesView, t *model.TransferScheduleRow) {
	{{ isGroup := t.IsGroup() }}
	<tr
		class={
			"transition-colors hover:bg-base-200/50",
			templ.KV("cursor-pointer font-semibold collapsed", isGroup),
		}
		if isGroup {
			data-template-id={ t.ID }
			onclick="window.toggleTemplateRow(this)"
		}
	>
		<!-- Name + Status dot + Date range -->
		<td class="font-medium">
			<div class="flex flex-col gap-0.5">
				<div class="flex items-center gap-2">
					if isGroup {
						<button
							type="button"
							class="collapse-toggle btn btn-ghost btn-xs p-0 min-h-0 h-4 w-4"
							title="Toggle group members"
						>
							<svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</button>
					} else {
						<span class="w-4 shrink-0"></span>
					}
					switch t.ActiveState() {
						case "Active":
							<span class="inline-block w-2 h-2 rounded-full bg-success shrink-0" title="Active"></span>
						case "Inactive":
							<span class="inline-block w-2 h-2 rounded-full bg-warning shrink-0" title="Inactive"></span>
						case "Disabled":
							<span class="inline-block w-2 h-2 rounded-full bg-error shrink-0" title="Disabled"></span>
					}
					<span>{ t.Name }</span>
					if t.Source.IsGenerated() {
						<div class="badge badge-outline badge-sm gap-1" title={ t.Source.Label }>
							{ t.Source.Type }
						</div>
					}
					@EventBadge(view.GetEvent(t.EventID))
				</div>
				if t.StartDate > 0 || t.EndDate != nil {
					<div class="text-xs text-base-content/40 ml-6">
						if t.StartDate > 0 {
							{ t.StartDate.String() }
						} else {
							-
						}
						—
						if t.EndDate != nil {
							{ t.EndDate.String() }
						} else {
							-
						}
						if ended := view.GetEvent(t.EndedByEventID); ended != nil {
							<span title={ "Ended by the Event " + ended.Name }>(ended by { ended.Name })</span>
						}
					</div>
				}
			</div>
		</td>
		<!-- From → To (compact single line) -->
		<td class="text-sm whitespace-nowrap">
			{{ from := view.GetAccount(t.FromAccountID) }}
			{{ to := view.GetAccount(t.ToAccountID) }}
			if t.FromAccountID != "" {
				<span class="inline-block max-w-[12rem] truncate align-bottom" title={ from.Name }>{ from.Name }</span>
			} else {
				<span class="text-green-700">external</span>
			}
			<span class="text-base-content/40 mx-1">→</span>
			if t.ToAccountID != "" {
				<span class="inline-block max-w-[12rem] truncate align-bottom" title={ to.Name }>{ to.Name }</span>
			} else {
				<span class="text-red-400">external</span>
			}
		</td>
		<!-- Recurrence -->
		<td>
			<div class="flex flex-col gap-0.5">
				if !t.Recurring() {
					<span class="badge badge-secondary badge-sm">one-time</span>
				}
				if t.Recurrence != "" {
					<span>{ t.Recurrence }</span>
					<span class="text-xs text-base-content/50">{ t.Priority }</span>
				}
			</div>
		</td>
		<!-- Budget -->
		<td>
			{{ budgetCat := view.GetBudgetCategory(t.BudgetCategoryID) }}
			if budgetCat != nil {
				@CategoryBadge(*budgetCat)
			}
		</td>
		<!-- Amount (merged: estimated as primary, configured as secondary) -->
		<td class="text-right">
			<div class="flex flex-col items-end gap-0.5">
				{{ class := "" }}
				if t.ToAccountID == "" {
					{{ class = "text-red-600" }}
				}
				if t.FromAccountID == "" {
					{{ class = "text-green-600" }}
				}
				if isGroup {
					@BalanceBadge(t.Amount, false, class)
				} else {
					@BalanceBadge(t.Amount, false, class)
					if t.AmountType == model.TransferAmountPercent {
						<span class="text-xs text-base-content/40">{ ui.FormatPercent(t.AmountPercent) }%</span>
					} else if t.HasDifferentAmount() {
					    @BalanceBadge(t.AmountFixed.Mean(), false, "text-xs text-base-content/40")
					}
				}
			</div>
		</td>
		<!-- Actions -->
		<td class="text-right">
			<div class="flex items-center justify-end gap-1 row-actions">
				if isGroup && t.Source.IsGenerated() {
					<a class="btn btn-ghost btn-xs" title={ "Edit " + t.Source.Label } href={ sourceEditURL(t.Source) } onclick="event.stopPropagation()">
						@IconPencil("w-4 h-4")
					</a>
				}
				if !isGroup {
					if t.Source.IsGenerated() {
						<a class="btn btn-ghost btn-xs" title={ "Edit " + t.Source.Label } href={ sourceEditURL(t.Source) }>
							@IconPencil("w-4 h-4")
						</a>
					} else {
						<form method="post" action={ "/transfers/" + t.ID + "/duplicate" } style="display:inline;">
							<button type="submit" class="btn btn-ghost btn-xs" title="Duplicate">
								@IconCopy("w-4 h-4")
							</button>
						</form>
						<a class="btn btn-ghost btn-xs display-none" title="Edit" href={ "/transfer-templates/" + t.ID + "/edit" }>
							@IconPencil("w-4 h-4")
						</a>
					}
				}
			</div>
		</td>
	</tr>
}

// TransferTemplateMembers are the rows of the members of row, depth groups deep, each hidden until
// row is expanded. A member that is a group, such as a Bill of several amounts in its Bill Account,
// expands in turn.
templ TransferTemplateMembers(view *model.TransferTemplatesView, row *model.TransferScheduleRow, depth int) {
	for _, member := range row.Members {
		@TransferTemplateMemberRow(view, row.ID, &member, depth)
		if member.IsGroup() {
			@TransferTemplateMembers(view, &member, depth+1)
		}
	}
}

templ TransferTemplateMemberRow(view *model.TransferTemplatesView, parentID string, t *model.TransferScheduleRow, depth int) {
	{{ isGroup := t.IsGroup() }}
	<tr
		class={
			"hover:bg-base-200/50 transition-colors bg-base-100/50 hidden",
			templ.KV("cursor-pointer collapsed", isGroup),
		}
		data-parent-id={ parentID }
		if isGroup {
			data-template-id={ t.ID }
			onclick="window.toggleTemplateRow(this)"
		}
	>
		<td class="font-medium" style={ fmt.Sprintf("padding-left:%.1frem;", 0.5+2*float64(depth)) }>
			<div class="flex items-stretch gap-2">
				<div style="background-color:var(--color-base-content);opacity:0.2;" class="shrink-0"></div>
				<div class="flex flex-col gap-0.5">
				<div class="flex items-center gap-2">
					if isGroup {
						<button
							type="button"
							class="collapse-toggle btn btn-ghost btn-xs p-0 min-h-0 h-4 w-4 shrink-0"
							title="Toggle its amounts"
						>
							<svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</button>
					} else {
						<span class="w-4 shrink-0"></span>
					}
					switch t.ActiveState() {
						case "Active":
							<span class="inline-block w-2 h-2 rounded-full bg-success shrink-0" title="Active"></span>
						case "Inactive":
							<span class="inline-block w-2 h-2 rounded-full bg-warning shrink-0" title="Inactive"></span>
						case "Disabled":
							<span class="inline-block w-2 h-2 rounded-full bg-error shrink-0" title="Disabled"></span>
					}
					<span>{ t.Name }</span>
					if t.Source.IsGenerated() {
						<a href={ sourceEditURL(t.Source) } class="badge badge-outline badge-sm gap-1" title={ t.Source.Label }>
							{ t.Source.Type }
						</a>
					}
					@EventBadge(view.GetEvent(t.EventID))
				</div>
				if t.StartDate > 0 || t.EndDate != nil {
					<div class="text-xs text-base-content/40 ml-6">
						if t.StartDate > 0 {
							{ t.StartDate.String() }
						} else {
							-
						}
						—
						if t.EndDate != nil {
							{ t.EndDate.String() }
						} else {
							-
						}
					</div>
				}
				</div>
			</div>
		</td>
		<td class="text-sm whitespace-nowrap">
			{{ from := view.GetAccount(t.FromAccountID) }}
			{{ to := view.GetAccount(t.ToAccountID) }}
			if t.FromAccountID != "" {
				<span class="inline-block max-w-[12rem] truncate align-bottom" title={ from.Name }>{ from.Name }</span>
			} else {
				<span class="text-green-700">external</span>
			}
			<span class="text-base-content/40 mx-1">→</span>
			if t.ToAccountID != "" {
				<span class="inline-block max-w-[12rem] truncate align-bottom" title={ to.Name }>{ to.Name }</span>
			} else {
				<span class="text-red-400">external</span>
			}
		</td>
		<td>
			<div class="flex flex-col gap-0.5">
				if !t.Recurring() {
					<span class="badge badge-secondary badge-sm">one-time</span>
				}
				if t.Recurrence != "" {
					<span>{ t.Recurrence }</span>
					<span class="text-xs text-base-content/50">{ t.Priority }</span>
				}
			</div>
		</td>
		<td>
			{{ budgetCat := view.GetBudgetCategory(t.BudgetCategoryID) }}
			if budgetCat != nil {
				@CategoryBadge(*budgetCat)
			}
		</td>
		<td class="text-right">
			<div class="flex flex-col items-end gap-0.5">
				{{ class := "" }}
				if t.ToAccountID == "" {
					{{ class = "text-red-600" }}
				}
				if t.FromAccountID == "" {
					{{ class = "text-green-600" }}
				}
				@BalanceBadge(t.Amount, false, class)
				if !isGroup {
					if t.AmountType == model.TransferAmountPercent {
						<span class="text-xs text-base-content/40">{ ui.FormatPercent(t.AmountPercent) }%</span>
					} else if t.HasDifferentAmount() {
						@BalanceBadge(t.AmountFixed.Mean(), false, "text-xs text-base-content/40")
					}
				}
			</div>
		</td>
		<td class="text-right">
			<div class="flex items-center justify-end gap-1 row-actions">
				if t.Source.IsGenerated() {
					<a class="btn btn-ghost btn-xs" title={ "Edit " + t.Source.Label } href={ sourceEditURL(t.Source) } onclick="event.stopPropagation()">
						@IconPencil("w-4 h-4")
					</a>
				} else if !isGroup {
					<form method="post" action={ "/transfers/" + t.ID + "/duplicate" } style="display:inline;">
						<button type="submit" class="btn btn-ghost btn-xs" title="Duplicate">
							@IconCopy("w-4 h-4")
						</button>
					</form>
					<a class="btn btn-ghost btn-xs display-none" title="Edit" href={ "/transfer-templates/" + t.ID + "/edit" }>
						@IconPencil("w-4 h-4")
					</a>
				}
			</div>
		</td>
	</tr>
}

templ NewTransferTemplateButton() {
	{{ label := "New Transfer template" }}
	<a class="btn btn-primary" href="/transfer-templates/new" title={ label }>
		{ label }
		@IconPlus("w-4 h-4")
	</a>
}

templ TransferTemplatesContent(view *model.TransferTemplatesView) {
	<main class="flex-1 flex flex-col min-h-0">
		@Header("Transfer Templates", NewTransferTemplateButton())
		<div class="flex-1 p-6 overflow-auto bg-base-100">
			<div class="flex flex-col gap-4">
				@TransferTemplatesStatCardRow(view)
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<div class="overflow-x-auto">
							<style>
								tr[data-parent-id].hidden { display: none !important; }
								tr[data-template-id].collapsed .collapse-toggle svg { transform: rotate(0deg); }
								tr[data-template-id] .collapse-toggle svg { transform: rotate(90deg); }

							</style>
							<table class="table w-full">
								<thead class="bg-base-200/60">
									<tr>
										<th class="font-semibold">Name</th>
										<th class="font-semibold">From → To</th>
										<th class="font-semibold">Recurrence</th>
										<th class="font-semibold">Budget</th>
										<th class="font-semibold text-right">Amount</th>
										<th class="font-semibold text-right">Actions</th>
									</tr>
								</thead>
								<tbody>
									if len(view.Rows) == 0 {
										<tr>
											<td colspan="6" class="text-center py-8 text-base-content/70">
												<div class="flex flex-col items-center gap-2">
													@NoDataImg()
													<p class="text-lg font-medium">No accounts yet</p>
													<p>Create your first account to get started</p>
												</div>
											</td>
										</tr>
									} else {
										for _, row := range view.Rows {
											@TransferTemplateTableRow(view, &row)
											@TransferTemplateMembers(view, &row, 1)
										}
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
				if len(view.LeftOut) > 0 {
					@LeftOutTransferTemplates(view)
				}
			</div>
		</div>
	</main>
}

// LeftOutTransferTemplates lists the Transfer Templates the Events leave out of the Baseline: those
// of unplanned Events, at their Events' dates, and those that use their Accounts. They count in
// nothing on this page.
templ LeftOutTransferTemplates(view *model.TransferTemplatesView) {
	<div class="card bg-base-100 shadow-sm border border-base-300">
		<div class="card-body">
			<h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/60">Left out of the Baseline</h3>
			<p class="text-sm text-base-content/60">In unplanned Events, or using their accounts. They count in no total, Forecast or budget.</p>
			<div class="overflow-x-auto">
				<table class="table table-sm w-full">
					<thead class="bg-base-200/60">
						<tr>
							<th class="font-semibold">Name</th>
							<th class="font-semibold">From → To</th>
							<th class="font-semibold">Recurrence</th>
							<th class="font-semibold text-right">Amount</th>
							<th class="font-semibold text-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, t := range view.LeftOut {
							<tr class="text-base-content/70">
								<td>
									<div class="flex items-center gap-2">
										<span>{ t.Name }</span>
										@EventBadge(view.GetEvent(t.EventID))
									</div>
									<div class="text-xs text-base-content/40">
										{ t.StartDate.String() } —
										if t.EndDate != nil {
											{ t.EndDate.String() }
										} else {
											-
										}
									</div>
								</td>
								<td class="text-sm whitespace-nowrap">
									if t.FromAccountID != "" {
										{ view.GetAccount(t.FromAccountID).Name }
									} else {
										external
									}
									<span class="text-base-content/40 mx-1">→</span>
									if t.ToAccountID != "" {
										{ view.GetAccount(t.ToAccountID).Name }
									} else {
										external
									}
								</td>
								<td class="font-mono text-sm">{ string(t.Recurrence) }</td>
								<td class="text-right">
									if t.AmountType == model.TransferAmountPercent {
										<span class="text-xs">{ ui.FormatPercent(t.AmountPercent) }%</span>
									} else {
										@BalanceBadge(t.AmountFixed.Mean(), false, "")
									}
								</td>
								<td class="text-right">
									if t.Source.IsGenerated() {
										<a class="btn btn-ghost btn-xs" title={ "Edit " + t.Source.Label } href={ sourceEditURL(t.Source) }>
											@IconPencil("w-4 h-4")
										</a>
									} else {
										<a class="btn btn-ghost btn-xs" title="Edit" href={ "/transfer-templates/" + t.ID + "/edit" }>
											@IconPencil("w-4 h-4")
										</a>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

// sourceEditURL is the edit page of what a generated Transfer Template is generated from: its Salary,
// or the Bill Account that lists its Bill.
func sourceEditURL(source model.TransferTemplateSource) templ.SafeURL {
	switch source.Type {
	case model.TransferSourceSalary:
		return templ.SafeURL("/salaries/" + source.EntityID + "/edit")
	case model.TransferSourceBill:
		return templ.SafeURL("/bills/" + source.BillAccountID + "/edit")
	}
	return ""
}
